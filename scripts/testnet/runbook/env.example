# Aura testnet runbook environment
RUN_ID=
CHAIN_ID=aura-testnet-1
RPC_URL=https://testnet-rpc.aurablockchain.org
REST_URL=https://testnet-api.aurablockchain.org
GRAPHQL_URL=https://testnet-graphql.aurablockchain.org/graphql
RPC_WS_URL=
ARCHIVE_RPC_URL=
FAUCET_URL=https://testnet-faucet.aurablockchain.org/faucet
DENOM=uaura
BIN=aurad
HOME_DIR=$HOME/.aura
KEY_NAME=runbook-aura
KEY_NAME_DST=runbook-aura-dst
SEND_AMOUNT=1
FEE_AMOUNT=500
OUT_DIR=./out
