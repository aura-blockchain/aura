{
  "name": "aura-browser-wallet-extension",
  "version": "1.0.0",
  "description": "Aura Browser Wallet - Lightweight wallet and staking/DEX controls",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:firefox": "node build.js --firefox",
    "watch": "node build.js --watch",
    "lint": "eslint . --ext js --fix",
    "format": "prettier --write \"**/*.{js,json,html,css}\"",
    "test": "vitest",
    "security:audit": "npm audit --audit-level=moderate",
    "clean": "rimraf dist dist-firefox",
    "package": "npm run build && cd dist && zip -r ../extension.zip .",
    "package:firefox": "npm run build:firefox && cd dist-firefox && zip -r ../extension-firefox.zip ."
  },
  "dependencies": {
    "@keystonehq/keystone-sdk": "^0.11.6",
    "@ledgerhq/hw-app-cosmos": "^6.28.7",
    "@ledgerhq/hw-transport-webhid": "^6.28.7",
    "@walletconnect/sign-client": "^2.23.1",
    "dompurify": "^3.0.8",
    "trezor-connect": "^8.2.12"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@types/chrome": "^0.0.258",
    "esbuild": "^0.27.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^2.1.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "blockchain",
    "cryptocurrency",
    "wallet",
    "mining",
    "browser-extension"
  ],
  "author": "Aura Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
