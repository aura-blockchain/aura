    },
    "AutoScalingConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Whether auto-scaling is enabled"
        },
        "initialAmounts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uint64"
          },
          "title": "Initial amounts per transaction type"
        },
        "targetCacheHitRate": {
          "type": "string",
          "title": "Target cache hit rate (percentage) - stored as string for deterministic serialization (sdk.Dec)"
        },
        "minCacheHitRate": {
          "type": "string",
          "title": "Minimum cache hit rate before scaling down - stored as string for deterministic serialization (sdk.Dec)"
        },
        "maxAmounts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uint64"
          },
          "title": "Maximum pre-validations per type"
        },
        "scaleUpFactor": {
          "type": "string",
          "title": "Scaling factor (multiply by this when scaling up) - stored as string for deterministic serialization (sdk.Dec)"
        },
        "scaleDownFactor": {
          "type": "string",
          "title": "Scaling factor (multiply by this when scaling down) - stored as string for deterministic serialization (sdk.Dec)"
        },
        "cooldownMinutes": {
          "type": "integer",
          "format": "int64",
          "title": "Cooldown period between scaling events (minutes)"
        },
        "evaluationPeriodHours": {
          "type": "integer",
          "format": "int64",
          "title": "Evaluation period for scaling decisions (hours)"
        }
      },
      "title": "AutoScalingConfig defines auto-scaling parameters"
    },
