      "type": "string",
      "enum": [
        "CACHE_STRATEGY_UNSPECIFIED",
        "CACHE_STRATEGY_LRU",
        "CACHE_STRATEGY_LFU",
        "CACHE_STRATEGY_FIFO",
        "CACHE_STRATEGY_ADAPTIVE"
      ],
      "default": "CACHE_STRATEGY_UNSPECIFIED",
      "description": "- CACHE_STRATEGY_LRU: Least Recently Used\n - CACHE_STRATEGY_LFU: Least Frequently Used\n - CACHE_STRATEGY_FIFO: First In First Out\n - CACHE_STRATEGY_ADAPTIVE: Adaptive based on hit rates",
      "title": "CacheStrategy defines how pre-validated transactions are cached"
    },
