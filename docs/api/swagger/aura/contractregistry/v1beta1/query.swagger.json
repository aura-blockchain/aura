    "ContractMetadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "Contract name"
        },
        "description": {
          "type": "string",
          "title": "Detailed description"
        },
        "version": {
          "type": "string",
          "title": "Version string (e.g., \"1.0.0\")"
        },
        "homepage": {
          "type": "string",
          "title": "Homepage URL"
        },
