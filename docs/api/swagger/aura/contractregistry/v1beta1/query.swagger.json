    "AuditEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uint64",
          "title": "Unique entry ID (auto-assigned)"
        },
        "contractAddress": {
          "type": "string",
          "title": "Contract address being audited"
        },
        "timestamp": {
          "type": "string",
          "format": "int64",
          "title": "Unix timestamp of the action"
        },
        "action": {
          "type": "string",
          "title": "Type of action (e.g., EXECUTE_CONTRACT, STATUS_CHANGE, MIGRATE_FROM)"
        },
        "actor": {
          "type": "string",
          "title": "Address of the actor performing the action"
        },
        "details": {
          "type": "string",
          "title": "Detailed description of the action"
        },
        "success": {
          "type": "boolean",
          "title": "Whether the action succeeded"
        }
      },
      "title": "AuditEntry represents a single audit trail entry for a contract"
    },
    "AuditHistoryEntry": {
      "type": "object",
      "properties": {
        "auditorName": {
          "type": "string",
          "title": "Name of the auditor or firm"
        },
        "auditDate": {
          "type": "string",
          "format": "int64",
          "title": "Unix timestamp of the audit date"
        },
        "auditScore": {
          "type": "integer",
          "format": "int32",
          "title": "Audit score (0-100)"
        },
        "reportUri": {
          "type": "string",
          "title": "URI to the audit report"
        },
        "findingsSummary": {
          "type": "string",
          "title": "Findings summary"
        },
        "criticalIssues": {
          "type": "integer",
          "format": "int32",
          "title": "Number of critical issues found"
        },
        "highIssues": {
          "type": "integer",
          "format": "int32",
          "title": "Number of high issues found"
        },
        "mediumIssues": {
          "type": "integer",
          "format": "int32",
          "title": "Number of medium issues found"
        },
        "lowIssues": {
          "type": "integer",
          "format": "int32",
          "title": "Number of low issues found"
        }
      },
      "title": "AuditHistoryEntry represents a single audit in the contract's history"
    },
    "AuditStatistics": {
      "type": "object",
      "properties": {
        "contractAddress": {
          "type": "string",
          "title": "Contract address"
        },
        "totalEntries": {
          "type": "string",
          "format": "uint64",
          "title": "Total audit entries"
        },
        "successCount": {
          "type": "string",
          "format": "uint64",
          "title": "Number of successful actions"
        },
        "failureCount": {
          "type": "string",
          "format": "uint64",
          "title": "Number of failed actions"
        },
        "actionCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uint64"
          },
          "title": "Count of each action type (action -\u003e count)"
        }
      },
      "title": "AuditStatistics aggregates audit trail statistics"
    },
    "ComplianceRequirements": {
      "type": "object",
      "properties": {
        "enforceKyc": {
