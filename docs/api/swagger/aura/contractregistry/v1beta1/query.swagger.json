        "CONTRACT_STATUS_DEPRECATED",
        "CONTRACT_STATUS_FROZEN"
      ],
      "default": "CONTRACT_STATUS_UNSPECIFIED",
      "description": "- CONTRACT_STATUS_UNSPECIFIED: Unspecified (invalid)\n - CONTRACT_STATUS_ACTIVE: Active and operational\n - CONTRACT_STATUS_PAUSED: Temporarily paused\n - CONTRACT_STATUS_DEPRECATED: Deprecated (discouraged use)\n - CONTRACT_STATUS_FROZEN: Frozen (emergency stop)",
