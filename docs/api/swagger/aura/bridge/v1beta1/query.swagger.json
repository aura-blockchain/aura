  "definitions": {
    "Any": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "BridgeParams": {
      "type": "object",
      "properties": {
        "minConfirmations": {
          "type": "string",
          "format": "uint64",
          "title": "Minimum confirmations for transfers"
        },
        "bridgeFeeBasisPoints": {
          "type": "string",
          "format": "uint64",
          "title": "Bridge fee percentage (basis points, e.g., 30 = 0.3%)"
        },
        "maxTransferAmount": {
          "type": "string",
          "title": "Maximum transfer amount per transaction"
        },
        "enabled": {
          "type": "boolean",
          "title": "Bridge enabled"
        },
        "validatorThresholdPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Required validator threshold for confirmations (percentage)"
        }
      },
      "title": "BridgeParams defines the parameters for the bridge module"
    },
    "BridgeValidator": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "title": "Validator address on AURA"
        },
        "publicKey": {
          "type": "string",
          "format": "byte",
          "title": "Validator public key"
        },
        "power": {
          "type": "string",
          "format": "uint64",
          "title": "Voting power / weight"
        },
        "active": {
          "type": "boolean",
          "title": "Active status"
        },
        "chains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Chains this validator relays for"
        }
      },
      "title": "BridgeValidator represents a validator authorized to relay cross-chain transfers"
    },
    "Coin": {
      "type": "object",
      "properties": {
        "denom": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        }
      },
      "description": "Coin defines a token with a denomination and an amount.\n\nNOTE: The amount field is an Int which implements the custom method\nsignatures required by gogoproto."
    },
    "CrossChainTransfer": {
      "type": "object",
      "properties": {
        "transferId": {
          "type": "string",
          "title": "Unique transfer identifier"
        },
        "sourceChain": {
          "type": "string",
          "title": "Source chain (\"aura\", \"paw\", \"xai\")"
        },
        "targetChain": {
          "type": "string",
          "title": "Target chain (\"aura\", \"paw\", \"xai\")"
        },
        "sender": {
          "type": "string",
          "title": "Sender address on source chain"
        },
        "recipient": {
          "type": "string",
          "title": "Recipient address on target chain"
        },
        "amount": {
          "type": "string",
          "title": "Amount transferred"
        },
        "denom": {
          "type": "string",
          "title": "Token denomination"
        },
        "sourceTxHash": {
          "type": "string",
          "title": "Transaction hash on source chain"
        },
        "targetTxHash": {
          "type": "string",
          "title": "Transaction hash on target chain (once minted)"
        },
        "status": {
          "$ref": "#/definitions/TransferStatus",
          "title": "Transfer status"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "title": "Timestamp of transfer initiation"
        },
        "confirmations": {
          "type": "string",
          "format": "uint64",
          "title": "Number of validator confirmations"
        },
        "requiredConfirmations": {
          "type": "string",
          "format": "uint64",
          "title": "Required confirmations"
        },
        "validatorSignatures": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ValidatorSignature"
          },
          "title": "Validator signatures"
        }
      },
      "title": "CrossChainTransfer represents a transfer between AURA, PAW, or XAI chains"
    },
    "QueryAllChainsResponse": {
      "type": "object",
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1beta1.ChainConfig"
          }
        }
      }
    },
    "QueryAllTransfersResponse": {
      "type": "object",
      "properties": {
        "transfers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/CrossChainTransfer"
          }
        }
      }
    },
    "QueryAllWrappedTokensResponse": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1beta1.WrappedToken"
          }
        }
      }
    },
    "QueryBridgeStatsResponse": {
      "type": "object",
      "properties": {
        "totalTransfers": {
          "type": "string",
          "format": "uint64",
          "title": "Total transfers processed"
        },
        "transfersByStatus": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uint64"
          },
          "title": "Transfers by status"
        },
        "volumeByChain": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "Total volume by chain"
        },
        "totalWrappedTokens": {
          "type": "string",
          "format": "uint64",
          "title": "Total wrapped tokens"
        },
        "activeValidators": {
          "type": "string",
          "format": "uint64",
          "title": "Active validators"
        },
        "activeRelayers": {
          "type": "string",
          "format": "uint64",
          "title": "Active relayers"
        },
        "avgCompletionTime": {
          "type": "string",
          "format": "uint64",
          "title": "Average completion time (seconds)"
        }
      }
    },
    "QueryChainConfigResponse": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/definitions/v1beta1.ChainConfig"
        }
      }
    },
    "QueryCrossChainSwapResponse": {
      "type": "object",
      "properties": {
        "swap": {
          "$ref": "#/definitions/v1beta1.CrossChainSwap"
        }
      }
    },
    "QueryParamsResponse": {
      "type": "object",
