        }
      }
    },
    "QuerySharedIdentityResponse": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/definitions/v1beta1.SharedIdentity"
        }
      }
    },
    "QueryTransferResponse": {
      "type": "object",
      "properties": {
        "transfer": {
          "$ref": "#/definitions/CrossChainTransfer"
        }
      }
    },
    "QueryUserTransfersResponse": {
      "type": "object",
      "properties": {
        "transfers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/CrossChainTransfer"
          }
        }
      }
    },
    "QueryValidatorsResponse": {
      "type": "object",
      "properties": {
        "validators": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/BridgeValidator"
          }
        }
      }
    },
    "QueryWrappedTokenResponse": {
      "type": "object",
      "properties": {
        "token": {
          "$ref": "#/definitions/v1beta1.WrappedToken"
        }
      }
    },
    "Status": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Any"
          }
        }
      }
    },
    "TransferStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "RELAYED",
        "COMPLETED",
        "FAILED",
        "REFUNDED"
      ],
      "default": "PENDING",
      "description": "- PENDING: Waiting for confirmations\n - CONFIRMED: Confirmed on source chain\n - RELAYED: Relayed to target chain\n - COMPLETED: Minted/unlocked on target chain\n - FAILED: Transfer failed\n - REFUNDED: Tokens refunded to sender",
      "title": "TransferStatus represents the lifecycle of a cross-chain transfer"
    },
    "ValidatorSignature": {
      "type": "object",
      "properties": {
        "validatorAddress": {
          "type": "string",
          "title": "Validator address"
        },
        "signature": {
          "type": "string",
          "format": "byte",
          "title": "Signature"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "title": "Timestamp of signature"
        }
      },
      "title": "ValidatorSignature contains validator's signature for cross-chain transfer"
    },
    "v1beta1.ChainConfig": {
      "type": "object",
      "properties": {
        "chainId": {
          "type": "string",
          "title": "Chain identifier (\"aura\", \"paw\", \"xai\")"
        },
        "chainName": {
          "type": "string",
          "title": "Human-readable chain name"
        },
        "rpcEndpoint": {
          "type": "string",
          "title": "RPC endpoint"
        },
        "addressPrefix": {
          "type": "string",
          "title": "Address prefix (e.g., \"aura\", \"paw\", \"xai\")"
        },
        "bridgeContract": {
          "type": "string",
          "title": "Bridge contract address (if applicable)"
        },
        "minConfirmations": {
          "type": "string",
          "format": "uint64",
          "title": "Minimum confirmations required"
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Active validators for this bridge"
        },
        "enabled": {
          "type": "boolean",
          "title": "Enabled for transfers"
        },
        "nativeDenom": {
          "type": "string",
          "title": "Native token denomination"
        }
      },
      "title": "ChainConfig contains configuration for each connected chain"
    },
    "v1beta1.CrossChainSwap": {
      "type": "object",
      "properties": {
        "swapId": {
          "type": "string",
          "title": "Unique swap identifier"
        },
        "sourceChain": {
          "type": "string",
          "title": "Source chain and token"
        },
        "sourceCoin": {
          "$ref": "#/definitions/Coin"
        },
        "targetChain": {
          "type": "string",
          "title": "Target chain and token"
        },
        "targetDenom": {
          "type": "string"
        },
        "minTargetAmount": {
          "type": "string"
        },
        "sender": {
          "type": "string",
          "title": "User addresses"
        },
        "recipient": {
          "type": "string"
        },
        "route": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "[\"aura\", \"osmosis\", \"paw\"]",
          "title": "Route (may involve multiple hops)"
        },
        "status": {
          "type": "string",
          "title": "Status"
        },
        "initiatedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Execution details"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finalAmount": {
          "type": "string",
          "title": "Final amount received"
        }
      },
      "title": "CrossChainSwap represents a swap executed across multiple chains\nExample: Swap AURA on AURA chain for PAW on PAW chain"
    },
    "v1beta1.RelayerStats": {
      "type": "object",
      "properties": {
        "relayerAddress": {
          "type": "string"
        },
        "totalTransfersRelayed": {
          "type": "string",
          "format": "uint64"
        },
        "successfulTransfers": {
          "type": "string",
          "format": "uint64"
        },
        "failedTransfers": {
          "type": "string",
          "format": "uint64"
        },
        "totalVolume": {
          "type": "string"
        },
        "lastRelay": {
          "type": "string",
          "format": "date-time"
        },
        "uptimePercentage": {
          "type": "string"
        }
      },
      "title": "RelayerStats tracks performance of bridge relayers"
    },
    "v1beta1.SharedIdentity": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "title": "User address (on any chain)"
        },
        "verifiedAura": {
          "type": "boolean",
          "title": "Verified on AURA"
        },
        "verifiedPaw": {
          "type": "boolean",
          "title": "Verified on PAW"
        },
        "verifiedXai": {
          "type": "boolean",
          "title": "Verified on XAI"
        },
        "auraIrScore": {
          "type": "string",
          "format": "uint64",
          "title": "AURA IR score (0-100)"
        },
        "linkedAddresses": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "chain_id -\u003e address",
          "title": "Linked addresses on other chains"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Verification timestamp"
        },
        "reputationScore": {
          "type": "string",
          "format": "uint64",
          "title": "Reputation score (0-1000)"
        }
      },
      "title": "SharedIdentity allows identity verification to work across AURA, PAW, and XAI"
    },
    "v1beta1.WrappedToken": {
      "type": "object",
      "properties": {
        "wrappedDenom": {
          "type": "string",
          "title": "Wrapped token denomination on AURA (e.g., \"paw.token\", \"xai.coin\")"
        },
        "originalDenom": {
          "type": "string",
          "title": "Original denomination on source chain"
        },
        "sourceChain": {
          "type": "string",
          "title": "Source chain"
        },
        "totalSupply": {
          "type": "string",
          "title": "Total supply of wrapped tokens"
        },
        "decimals": {
          "type": "integer",
          "format": "int64",
          "title": "Decimals"
        },
        "lockedAmount": {
          "type": "string",
          "title": "Locked amount on source chain (for verification)"
        }
      },
      "title": "WrappedToken represents a token from another chain wrapped on AURA"
    }
  }
}
