      "type": "string",
      "enum": [
        "VESTING_TYPE_UNSPECIFIED",
        "VESTING_TYPE_LINEAR",
        "VESTING_TYPE_CLIFF",
        "VESTING_TYPE_GRADED",
        "VESTING_TYPE_MILESTONE"
      ],
      "default": "VESTING_TYPE_UNSPECIFIED",
      "title": "VestingType defines the type of vesting"
    },
    "VoteOption": {
      "type": "string",
      "enum": [
        "VOTE_OPTION_UNSPECIFIED",
        "VOTE_OPTION_YES",
        "VOTE_OPTION_ABSTAIN",
        "VOTE_OPTION_NO",
        "VOTE_OPTION_NO_WITH_VETO"
      ],
      "default": "VOTE_OPTION_UNSPECIFIED",
      "title": "VoteOption defines vote options"
    },
    "WeightedVoteOption": {
      "type": "object",
      "properties": {
        "option": {
          "$ref": "#/definitions/VoteOption"
        },
        "weight": {
          "type": "string"
        }
      }
    },
