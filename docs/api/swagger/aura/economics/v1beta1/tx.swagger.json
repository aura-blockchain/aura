    "MsgUpdateParamsResponse": {
      "type": "object"
    },
    "MsgVoteResponse": {
      "type": "object"
    },
    "MsgVoteWeightedResponse": {
      "type": "object"
    },
    "ProposalCategory": {
      "type": "string",
      "enum": [
        "PROPOSAL_CATEGORY_UNSPECIFIED",
        "PROPOSAL_CATEGORY_TEXT",
        "PROPOSAL_CATEGORY_PARAMETER_CHANGE",
        "PROPOSAL_CATEGORY_SOFTWARE_UPGRADE",
        "PROPOSAL_CATEGORY_SPENDING",
        "PROPOSAL_CATEGORY_EMERGENCY",
        "PROPOSAL_CATEGORY_CONSTITUTION"
      ],
      "default": "PROPOSAL_CATEGORY_UNSPECIFIED",
      "title": "ProposalCategory defines proposal category"
    },
    "ScheduleType": {
      "type": "string",
      "enum": [
        "SCHEDULE_TYPE_UNSPECIFIED",
        "SCHEDULE_TYPE_TEAM",
        "SCHEDULE_TYPE_INVESTOR",
        "SCHEDULE_TYPE_ADVISOR",
        "SCHEDULE_TYPE_ECOSYSTEM",
        "SCHEDULE_TYPE_COMMUNITY"
      ],
      "default": "SCHEDULE_TYPE_UNSPECIFIED",
      "title": "ScheduleType defines who the vesting schedule is for"
    },
    "Status": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Any"
          }
        }
      }
    },
