      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Whether whale protection is enabled"
        },
        "maxSingleTransfer": {
          "type": "string",
          "title": "Maximum single transfer"
        },
        "dailyTransferLimit": {
          "type": "string",
          "title": "Daily transfer limit per address"
        },
        "cooldownPeriod": {
          "type": "string",
          "title": "Cooldown period between large transfers"
        },
        "maxHoldingPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Maximum holding percentage (basis points of total supply)"
        },
        "largeTxThreshold": {
          "type": "string",
          "format": "uint64",
          "title": "Threshold for large transaction (basis points of total supply)"
        },
        "exemptedAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Exempted addresses (e.g., DEX contracts)"
        }
      },
      "title": "WhaleProtectionParams defines whale protection parameters"
    },
    "v1beta1.Params": {
      "type": "object",
      "properties": {
        "fees": {
          "$ref": "#/definitions/FeeParams",
          "title": "Fee-related parameters"
        },
        "vesting": {
          "$ref": "#/definitions/VestingParams",
          "title": "Vesting-related parameters"
        },
        "treasury": {
          "$ref": "#/definitions/TreasuryParams",
          "title": "Treasury-related parameters"
        },
        "governance": {
          "$ref": "#/definitions/GovernanceParams",
          "title": "Governance-related parameters"
        },
        "mev": {
          "$ref": "#/definitions/MEVParams",
          "title": "MEV protection parameters"
        },
        "whaleProtection": {
          "$ref": "#/definitions/WhaleProtectionParams",
          "title": "Whale protection parameters"
        },
        "liquidityMining": {
          "$ref": "#/definitions/LiquidityMiningParams",
          "title": "Liquidity mining parameters"
        },
        "tokenomics": {
          "$ref": "#/definitions/TokenomicsParams",
          "title": "Tokenomics parameters"
        }
      },
      "title": "Params defines the unified economics module parameters"
    }
  }
}
