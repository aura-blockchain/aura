{
  "swagger": "2.0",
  "info": {
    "title": "aura/economics/v1beta1/tx.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "Msg"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {},
  "definitions": {
    "Any": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "Coin": {
      "type": "object",
      "properties": {
        "denom": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        }
      },
      "description": "Coin defines a token with a denomination and an amount.\n\nNOTE: The amount field is an Int which implements the custom method\nsignatures required by gogoproto."
    },
    "FeeParams": {
      "type": "object",
      "properties": {
        "baseFee": {
          "type": "string",
          "title": "Base fee for transactions"
        },
        "minGasPrice": {
          "type": "string",
          "title": "Minimum gas price"
        },
        "dynamicFeesEnabled": {
          "type": "boolean",
          "title": "Whether dynamic fees are enabled"
        },
        "feeBurnPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Percentage of fees to burn (basis points)"
        },
        "minFeeMultiplier": {
          "type": "string",
          "format": "uint64",
          "title": "Fee multiplier range for dynamic adjustment"
        },
        "maxFeeMultiplier": {
          "type": "string",
          "format": "uint64"
        },
        "targetBlockUtilization": {
          "type": "string",
          "format": "uint64",
          "title": "Target block utilization (basis points)"
        },
        "feeAdjustmentSpeed": {
          "type": "string",
          "format": "uint64",
          "title": "Fee adjustment speed"
        }
      },
      "title": "FeeParams defines fee-related parameters"
    },
    "GovernanceParams": {
      "type": "object",
      "properties": {
        "minDeposit": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Coin"
          },
          "title": "Minimum deposit to create proposal"
        },
        "maxDepositPeriod": {
          "type": "string",
          "title": "Maximum deposit period"
        },
        "votingPeriod": {
          "type": "string",
          "title": "Voting period"
        },
        "quorum": {
          "type": "string",
          "format": "uint64",
          "title": "Quorum percentage (basis points)"
        },
        "threshold": {
          "type": "string",
          "format": "uint64",
          "title": "Threshold percentage (basis points)"
        },
        "vetoThreshold": {
          "type": "string",
          "format": "uint64",
          "title": "Veto threshold percentage (basis points)"
        },
        "executionDelay": {
          "type": "string",
          "title": "Execution delay (timelock)"
        },
        "emergencyVotingPeriod": {
          "type": "string",
          "title": "Emergency voting period (fast-track)"
        },
        "emergencyQuorum": {
          "type": "string",
          "format": "uint64",
          "title": "Emergency quorum (basis points)"
        },
        "emergencyThreshold": {
          "type": "string",
          "format": "uint64",
          "title": "Emergency threshold (basis points)"
        },
        "quadraticVotingEnabled": {
          "type": "boolean",
          "title": "Whether quadratic voting is enabled"
        },
        "voteLockingEnabled": {
          "type": "boolean",
          "title": "Whether vote locking is enabled"
        },
        "minLockDuration": {
          "type": "string",
          "title": "Minimum lock duration for voting boost"
        },
        "maxLockDuration": {
          "type": "string",
          "title": "Maximum lock duration"
        },
        "lockMultiplierPerYear": {
          "type": "string",
          "format": "uint64",
          "title": "Vote power multiplier per year locked (basis points)"
        },
        "snapshotVotingEnabled": {
          "type": "boolean",
          "title": "Whether snapshot voting is enabled"
        },
        "snapshotLookbackBlocks": {
          "type": "string",
          "format": "uint64",
          "title": "Snapshot lookback blocks"
        },
        "secretBallotEnabled": {
          "type": "boolean",
          "title": "Whether secret ballot is enabled"
        },
        "revealPeriod": {
          "type": "string",
          "title": "Reveal period for secret ballots"
        }
      },
      "title": "GovernanceParams defines governance-related parameters"
    },
    "LiquidityMiningParams": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Whether liquidity mining is enabled"
        },
        "totalRewardsAllocated": {
          "type": "string",
          "title": "Total rewards allocated"
        },
        "maxRewardsPerEpoch": {
          "type": "string",
          "title": "Maximum rewards per epoch"
        },
        "epochDurationBlocks": {
          "type": "string",
          "format": "uint64",
          "title": "Epoch duration in blocks"
        },
        "irVerifiedMultiplier": {
          "type": "string",
          "format": "uint64",
          "title": "Reward multiplier for IR-verified users (basis points)"
        }
      },
      "title": "LiquidityMiningParams defines liquidity mining parameters"
    },
    "MEVParams": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Whether MEV protection is enabled"
        },
        "maxFrontrunPenalty": {
          "type": "string",
          "title": "Maximum frontrun penalty"
        },
        "auctionDuration": {
          "type": "string",
          "title": "MEV auction duration"
        },
        "userRedistributionPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "User redistribution percentage (basis points)"
        },
        "validatorPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Validator percentage (basis points)"
        },
        "treasuryPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Treasury percentage (basis points)"
        },
        "burnPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Burn percentage (basis points)"
        },
        "strategy": {
          "$ref": "#/definitions/MEVRedistributionStrategy",
          "title": "MEV redistribution strategy"
        }
      },
      "title": "MEVParams defines MEV protection parameters"
    },
    "MEVRedistributionStrategy": {
      "type": "string",
      "enum": [
        "MEV_STRATEGY_UNSPECIFIED",
        "MEV_STRATEGY_PROPORTIONAL_TO_STAKE",
        "MEV_STRATEGY_PROPORTIONAL_TO_ACTIVITY",
        "MEV_STRATEGY_EQUAL_DISTRIBUTION",
        "MEV_STRATEGY_IR_WEIGHTED"
      ],
      "default": "MEV_STRATEGY_UNSPECIFIED",
      "title": "MEVRedistributionStrategy defines how MEV is redistributed"
    },
    "MsgAdjustInflationRateResponse": {
      "type": "object",
      "properties": {
        "oldRate": {
          "type": "string",
          "format": "uint64"
        },
        "newRate": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "MsgCreateVestingScheduleResponse": {
      "type": "object",
      "properties": {
        "scheduleId": {
          "type": "string"
        }
      }
    },
    "MsgDelegateVoteResponse": {
      "type": "object"
    },
    "MsgDepositResponse": {
      "type": "object"
    },
    "MsgExecuteProposalResponse": {
      "type": "object"
    },
    "MsgExecuteTreasurySpendResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      }
    },
    "MsgLockVotingTokensResponse": {
      "type": "object",
      "properties": {
        "lockId": {
          "type": "string"
        },
        "votingPower": {
          "type": "string"
        }
      }
    },
    "MsgProposeTreasurySpendResponse": {
      "type": "object",
      "properties": {
        "txId": {
          "type": "string"
        },
        "executableAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "MsgReleaseVestedTokensResponse": {
      "type": "object",
      "properties": {
        "amountReleased": {
          "$ref": "#/definitions/Coin"
        }
      }
    },
    "MsgRevealSecretVoteResponse": {
      "type": "object"
    },
    "MsgRevokeVestingScheduleResponse": {
      "type": "object",
      "properties": {
