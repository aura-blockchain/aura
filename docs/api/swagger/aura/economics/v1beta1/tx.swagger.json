        "requiredSignatures": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "MsgSubmitProposalResponse": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "format": "uint64"
        }
      }
