    "TreasuryParams": {
      "type": "object",
      "properties": {
        "treasuryAddress": {
          "type": "string",
          "title": "Treasury address"
        },
        "communityPoolPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Community pool percentage (basis points)"
        },
        "burnPercentage": {
          "type": "string",
          "format": "uint64",
          "title": "Burn percentage (basis points)"
        },
        "multisigThreshold": {
          "type": "integer",
          "format": "int64",
          "title": "Multi-signature threshold"
        },
        "authorizedSigners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Authorized signers"
        },
        "spendingLimit": {
          "type": "string",
          "title": "Spending limit without multisig"
        },
        "timelockDuration": {
          "type": "string",
          "title": "Timelock duration for large transactions"
        }
      },
      "title": "TreasuryParams defines treasury-related parameters"
    },
    "VestingParams": {
      "type": "object",
      "properties": {
        "minVestingDuration": {
          "type": "string",
          "title": "Minimum vesting duration"
        },
        "maxVestingDuration": {
          "type": "string",
          "title": "Maximum vesting duration"
        },
        "allowEarlyUnlock": {
          "type": "boolean",
          "title": "Whether early unlock is allowed"
        },
        "earlyUnlockPenalty": {
          "type": "string",
          "format": "uint64",
          "title": "Penalty for early unlock (basis points)"
        },
        "minCliffDuration": {
          "type": "string",
          "title": "Minimum cliff duration"
        }
      },
      "title": "VestingParams defines vesting-related parameters"
