      "type": "object",
      "properties": {
        "maxSupply": {
          "type": "string",
          "title": "Maximum supply cap"
        },
        "targetInflationRate": {
          "type": "string",
          "format": "uint64",
          "title": "Target inflation rate (basis points)"
        },
        "minInflationRate": {
          "type": "string",
          "format": "uint64",
          "title": "Minimum inflation rate (basis points)"
        },
        "maxInflationRate": {
          "type": "string",
          "format": "uint64",
          "title": "Maximum inflation rate (basis points)"
        },
        "inflationCheckInterval": {
          "type": "string",
          "format": "uint64",
          "title": "Inflation check interval (blocks)"
        },
        "inflationAlertThreshold": {
          "type": "string",
          "format": "uint64",
          "title": "Inflation alert threshold (basis points deviation from target)"
        }
