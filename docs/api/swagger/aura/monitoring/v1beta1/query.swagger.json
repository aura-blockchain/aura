            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "tags": [
          "Query"
        ]
      }
    },
    "/aura/monitoring/v1beta1/tvl": {
      "get": {
        "summary": "GetTVLMonitoring returns TVL monitoring data",
        "operationId": "Query_GetTVLMonitoring",
