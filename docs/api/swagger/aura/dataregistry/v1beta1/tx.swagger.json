{
  "swagger": "2.0",
  "info": {
    "title": "aura/dataregistry/v1beta1/tx.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "Msg"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {},
  "definitions": {
    "AccessMode": {
      "type": "string",
      "enum": [
        "ACCESS_MODE_PRIVATE",
        "ACCESS_MODE_WHITELIST",
        "ACCESS_MODE_PUBLIC",
        "ACCESS_MODE_VERIFIED_USERS"
      ],
      "default": "ACCESS_MODE_PRIVATE",
      "description": "- ACCESS_MODE_PRIVATE: Owner only\n - ACCESS_MODE_WHITELIST: Allowed addresses only\n - ACCESS_MODE_PUBLIC: Anyone can view\n - ACCESS_MODE_VERIFIED_USERS: Any AURA-verified user",
      "title": "AccessMode defines visibility policy"
    },
    "AccessPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/definitions/AccessMode"
        },
        "allowedAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Whitelist"
        },
        "deniedAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Blacklist"
        },
        "requireVerifiedIdentity": {
          "type": "boolean",
          "title": "Must have AURA VC"
        },
        "minConfidenceScore": {
          "type": "string",
          "format": "uint64",
          "title": "Minimum CS required"
        }
      },
      "title": "AccessPolicy controls who can view data"
    },
    "Any": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "DataItemType": {
      "type": "string",
      "enum": [
        "DATA_ITEM_TYPE_UNSPECIFIED",
        "DATA_ITEM_TYPE_VEHICLE_REGISTRATION",
        "DATA_ITEM_TYPE_VEHICLE_INSURANCE",
        "DATA_ITEM_TYPE_PROPERTY_DEED",
        "DATA_ITEM_TYPE_LEASE_AGREEMENT",
        "DATA_ITEM_TYPE_CONTRACT",
        "DATA_ITEM_TYPE_RECEIPT",
        "DATA_ITEM_TYPE_WARRANTY",
        "DATA_ITEM_TYPE_PHOTO",
        "DATA_ITEM_TYPE_VIDEO",
        "DATA_ITEM_TYPE_AUDIO",
        "DATA_ITEM_TYPE_DOCUMENT_PDF",
        "DATA_ITEM_TYPE_GOLF_SCORE",
        "DATA_ITEM_TYPE_TEST_SCORE",
        "DATA_ITEM_TYPE_CERTIFICATION",
        "DATA_ITEM_TYPE_ACHIEVEMENT",
        "DATA_ITEM_TYPE_NFT",
        "DATA_ITEM_TYPE_DIGITAL_ART",
        "DATA_ITEM_TYPE_MUSIC_LICENSE",
        "DATA_ITEM_TYPE_VACCINATION_RECORD",
        "DATA_ITEM_TYPE_MEDICAL_RECORD",
        "DATA_ITEM_TYPE_PRESCRIPTION",
        "DATA_ITEM_TYPE_CUSTOM"
      ],
      "default": "DATA_ITEM_TYPE_UNSPECIFIED",
      "description": "- DATA_ITEM_TYPE_VEHICLE_REGISTRATION: Documents\n - DATA_ITEM_TYPE_PHOTO: Media\n - DATA_ITEM_TYPE_GOLF_SCORE: Scores \u0026 Achievements\n - DATA_ITEM_TYPE_NFT: Digital Assets\n - DATA_ITEM_TYPE_VACCINATION_RECORD: Health\n - DATA_ITEM_TYPE_CUSTOM: Custom",
      "title": "DataItemType categorizes stored data"
    },
    "GeoLocation": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "format": "double"
        },
        "longitude": {
          "type": "number",
          "format": "double"
        },
        "altitude": {
          "type": "number",
          "format": "double",
          "title": "Optional"
        },
        "accuracyMeters": {
          "type": "number",
          "format": "double",
          "title": "GPS accuracy"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "title": "When location was captured"
        },
        "locationName": {
          "type": "string",
          "title": "\"Pebble Beach Golf Course\""
        }
      },
      "title": "GeoLocation for geotagged data"
    },
    "MsgDeleteDataItemResponse": {
      "type": "object",
      "properties": {
        "deletedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "MsgRevokeDataItemResponse": {
      "type": "object",
      "properties": {
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "MsgStoreDataItemResponse": {
      "type": "object",
      "properties": {
        "dataId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "MsgUpdateDataItemResponse": {
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "MsgVerifyDataItemResponse": {
      "type": "object",
      "properties": {
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verificationReward": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "Status": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Any"
          }
        }
      }
    },
    "VerificationLevel": {
      "type": "string",
      "enum": [
        "VERIFICATION_LEVEL_UNSPECIFIED",
        "VERIFICATION_LEVEL_SELF_ATTESTED",
        "VERIFICATION_LEVEL_PEER_VERIFIED",
        "VERIFICATION_LEVEL_AI_VERIFIED",
        "VERIFICATION_LEVEL_AUTHORITY_VERIFIED",
        "VERIFICATION_LEVEL_BLOCKCHAIN_ANCHORED"
      ],
      "default": "VERIFICATION_LEVEL_UNSPECIFIED",
      "description": "- VERIFICATION_LEVEL_SELF_ATTESTED: User claims, not verified\n - VERIFICATION_LEVEL_PEER_VERIFIED: Verified by another user\n - VERIFICATION_LEVEL_AI_VERIFIED: Verified by AI agent\n - VERIFICATION_LEVEL_AUTHORITY_VERIFIED: Verified by official authority\n - VERIFICATION_LEVEL_BLOCKCHAIN_ANCHORED: Anchored with external proof",
      "title": "VerificationLevel indicates trust level"
    }
  }
}
