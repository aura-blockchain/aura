        "PROPOSAL_STATUS_EXECUTION_DELAY",
        "PROPOSAL_STATUS_READY_FOR_EXECUTION",
        "PROPOSAL_STATUS_EXECUTED"
      ],
      "default": "PROPOSAL_STATUS_UNSPECIFIED",
      "title": "ProposalStatus defines the status of a governance proposal"
    },
