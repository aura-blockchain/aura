    "SwapOrderStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "MATCHED",
        "HTLC_CREATED",
        "COMPLETED",
        "CANCELLED",
        "EXPIRED"
      ],
      "default": "PENDING",
      "description": "- PENDING: Waiting for match\n - MATCHED: Found counterparty\n - HTLC_CREATED: Both HTLCs created\n - COMPLETED: Swap finished\n - CANCELLED: User cancelled\n - EXPIRED: Timed out",
      "title": "SwapOrderStatus represents order lifecycle\nAdapted from simple_swap_gui.py SwapOrderStatus"
    },
    "SwapOrderType": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ],
      "default": "BUY",
      "description": "- BUY: Buy AURA (sell other coin)\n - SELL: Sell AURA (buy other coin)",
      "title": "SwapOrderType represents buy or sell order\nAdapted from simple_swap_gui.py SwapOrderType"
