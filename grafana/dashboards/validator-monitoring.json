{
  "title": "Aura Validator Monitoring Dashboard",
  "tags": [
    "aura",
    "validators",
    "uptime"
  ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Validator Uptime",
      "type": "graph",
      "targets": [
        {
          "expr": "aura_monitoring_validator_uptime_percentage",
          "legendFormat": "{{moniker}}"
        }
      ],
      "yaxes": [
        {
          "label": "Uptime %",
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "id": 2,
      "title": "Active vs Jailed Validators",
      "type": "stat",
      "targets": [
        {
          "expr": "aura_monitoring_active_validators",
          "legendFormat": "Active"
        },
        {
          "expr": "aura_monitoring_jailed_validators",
          "legendFormat": "Jailed"
        }
      ]
    },
    {
      "id": 3,
      "title": "Missed Blocks by Validator",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(aura_monitoring_validator_missed_blocks_total[5m])",
          "legendFormat": "{{moniker}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Validator Alerts",
      "type": "table",
      "targets": [
        {
          "expr": "aura_monitoring_active_alerts{type=\"validator_down\"}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Top 10 Validators by Uptime",
      "type": "bargauge",
      "targets": [
        {
          "expr": "topk(10, aura_monitoring_validator_uptime_percentage)",
          "legendFormat": "{{moniker}}"
        }
      ]
    }
  ]
}
