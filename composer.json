{
  "name": "aequitas/aura",
  "description": "Companion tools for the Aequitas / AURA identity blockchain.",
  "type": "project",
  "require": {},
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.8",
    "wp-coding-standards/wpcs": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "Aequitas\\Wallet\\": "wallet/php/"
    }
  },
  "scripts": {
    "test": [
      "@phpunit",
      "@phpstan"
    ],
    "phpunit": "vendor/bin/phpunit --configuration phpunit.xml.dist",
    "phpstan": "vendor/bin/phpstan analyse --configuration phpstan.neon",
    "phpcs": "vendor/bin/phpcs --standard=phpcs.xml.dist --extensions=php chain ai-assistant wallet verifier-portal",
    "phpcbf": "vendor/bin/phpcbf --standard=phpcs.xml.dist --extensions=php chain ai-assistant wallet verifier-portal"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
