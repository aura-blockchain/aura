<?xml version="1.0"?>
<ruleset name="Aequitas PHP Standards">
    <description>PSR-12 + Squiz/Security helpers tuned for the PHP helpers in this repo.</description>
    <rule ref="PSR12">
        <exclude-pattern>*bootstrap.php</exclude-pattern>
        <exclude-pattern>*/node_modules/*</exclude-pattern>
        <exclude-pattern>wallet/desktop/node_modules/*</exclude-pattern>
        <exclude-pattern>wallet/mobile/node_modules/*</exclude-pattern>
    </rule>
</ruleset>
