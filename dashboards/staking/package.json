{
  "name": "aura-staking-dashboard",
  "version": "1.0.0",
  "description": "AURA Blockchain Staking Dashboard - Comprehensive staking tools for validators and delegators",
  "type": "module",
  "scripts": {
    "start": "http-server -p 8081",
    "dev": "http-server -p 8081 -c-1",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,css,html}\""
  },
  "keywords": [
    "blockchain",
    "staking",
    "cosmos",
    "aura",
    "validator",
    "delegation"
  ],
  "author": "AURA Network",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.3"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 4
  }
}
