{
  "name": "@aura/governance-dashboard",
  "version": "1.0.0",
  "description": "AURA Blockchain Governance Dashboard - Comprehensive tools for proposals, voting, and governance operations",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "python -m http.server 8082 || python3 -m http.server 8082",
    "dev": "python -m http.server 8082 || python3 -m http.server 8082",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/.bin/jest --ci --coverage --maxWorkers=2",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,css,html}\"",
    "verify": "npm run lint && npm run test",
    "build": "npm run lint && npm run test"
  },
  "keywords": [
    "aura",
    "blockchain",
    "governance",
    "cosmos",
    "proposals",
    "voting",
    "dao",
    "democracy"
  ],
  "author": "AURA Network Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aura-network/aura.git",
    "directory": "dashboards/governance"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/tests/__mocks__/styleMock.js"
    },
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  }
}
