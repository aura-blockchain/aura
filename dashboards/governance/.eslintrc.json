{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "globals": {
    "Chart": "readonly",
    "GovernanceAPI": "readonly",
    "ProposalList": "readonly",
    "ProposalDetail": "readonly",
    "CreateProposal": "readonly",
    "VotingPanel": "readonly",
    "TallyChart": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ]
  }
}
