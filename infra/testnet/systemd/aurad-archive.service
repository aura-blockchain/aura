[Unit]
Description=Aura Testnet Archive Node (Cosmovisor)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/aura/aurad-archive.env
ExecStart=${COSMOVISOR_BIN} run start \
  --home ${AURA_HOME} \
  --chain-id ${CHAIN_ID} \
  --moniker ${MONIKER} \
  --minimum-gas-prices ${MINIMUM_GAS_PRICES} \
  --log_level ${LOG_LEVEL}
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
