AURA_HOME=/home/ubuntu/.aura-archive
CHAIN_ID=aura-testnet-1
MONIKER=aura-testnet-archive
MINIMUM_GAS_PRICES=0.025uaura
LOG_LEVEL=info

COSMOVISOR_BIN=/usr/local/bin/cosmovisor
DAEMON_NAME=aurad
DAEMON_HOME=/home/ubuntu/.aura-archive
DAEMON_ALLOW_DOWNLOAD_BINARIES=false
DAEMON_RESTART_AFTER_UPGRADE=true
DAEMON_LOG_BUFFER_SIZE=512
