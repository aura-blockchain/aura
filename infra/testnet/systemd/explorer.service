[Unit]
Description=AURA Testnet Block Explorer
After=network-online.target aurad.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/aura/explorer
Environment="PATH=/home/ubuntu/explorer-venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="NODE_RPC_URL=http://localhost:10657"
Environment="NODE_API_URL=http://localhost:1317"
Environment="CHAIN_ID=aura-testnet-1"
Environment="DENOM=uaura"
Environment="EXPLORER_PORT=8082"
Environment="EXPLORER_HOST=0.0.0.0"
Environment="EXPLORER_DB_PATH=/home/ubuntu/aura/explorer/explorer.db"
ExecStart=/home/ubuntu/explorer-venv/bin/python3 explorer_backend.py
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
