# AURA Node Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# Node Configuration
# =============================================================================

# Chain identifier
AURA_CHAIN_ID=aura-testnet-1

# Node moniker (unique name for your node)
AURA_MONIKER=my-node

# Home directory for node data (default: ~/.aura)
# AURA_HOME=/custom/path

# =============================================================================
# Network Configuration
# =============================================================================

# P2P listening address
AURA_P2P_LADDR=tcp://0.0.0.0:26656

# RPC listening address
AURA_RPC_LADDR=tcp://0.0.0.0:26657

# gRPC listening address
AURA_GRPC_ADDRESS=0.0.0.0:9090

# API listening address
AURA_API_ADDRESS=tcp://0.0.0.0:1317

# Persistent peers (comma-separated)
AURA_PERSISTENT_PEERS=

# Seeds (comma-separated)
AURA_SEEDS=

# =============================================================================
# Database Configuration
# =============================================================================

# Database backend (goleveldb, rocksdb, pebbledb)
AURA_DB_BACKEND=goleveldb

# =============================================================================
# Logging
# =============================================================================

# Log level (debug, info, warn, error)
AURA_LOG_LEVEL=info

# Log format (plain, json)
AURA_LOG_FORMAT=plain

# =============================================================================
# Validator Configuration (if running as validator)
# =============================================================================

# Validator key name in keyring
# AURA_VALIDATOR_KEY=validator

# Minimum gas prices
AURA_MIN_GAS_PRICES=0.025uaura

# =============================================================================
# Telemetry
# =============================================================================

# Enable Prometheus metrics
AURA_PROMETHEUS_ENABLED=true

# Prometheus listening address
AURA_PROMETHEUS_ADDRESS=0.0.0.0:26660

# =============================================================================
# Security
# =============================================================================

# Enable CORS (for API)
AURA_CORS_ENABLED=false

# Allowed CORS origins (comma-separated)
# AURA_CORS_ALLOWED_ORIGINS=*
