# ============================================================================
# AURA Blockchain - Docker Secrets Template
# ============================================================================
# This file contains templates and instructions for generating secure secrets
# NEVER commit actual secrets to version control!
# ============================================================================

# ===========================================================================
# SETUP INSTRUCTIONS
# ===========================================================================
# 1. Copy this file: cp docker-compose.secrets.template .env.secrets
# 2. Run the secret generation script: ./deployment-security/scripts/generate-secrets.sh
# 3. Verify secrets are created in ./secrets/ directory
# 4. Ensure ./secrets/ is in .gitignore
# 5. Set proper file permissions: chmod 600 ./secrets/*
# 6. Review and customize values as needed
# ===========================================================================

# ===========================================================================
# AURA NODE CONFIGURATION
# ===========================================================================
CHAIN_ID=aura-mainnet-1
MONIKER=production-node-001
LOG_LEVEL=info
MINIMUM_GAS_PRICES=0.025uaura
AURA_VERSION=v1.0.0
AURA_COMMIT=latest

# ===========================================================================
# GRAFANA CREDENTIALS
# ===========================================================================
# Admin user (username)
GRAFANA_ADMIN_USER=admin

# Admin password (stored in ./secrets/grafana_admin_password.txt)
# Generate with: openssl rand -base64 32 > ./secrets/grafana_admin_password.txt
# Requirements:
# - Minimum 16 characters
# - Mix of uppercase, lowercase, numbers, symbols
# - No dictionary words
# Example: J8k#mQ2$pL9@vR5&nX7*wZ3!bC6^dF4%

# ===========================================================================
# POSTGRESQL CREDENTIALS
# ===========================================================================
# Database name
POSTGRES_DB=aura_indexer

# Database user
POSTGRES_USER=aura

# Database password (stored in ./secrets/postgres_password.txt)
# Generate with: openssl rand -base64 32 > ./secrets/postgres_password.txt
# Requirements:
# - Minimum 16 characters
# - Mix of uppercase, lowercase, numbers, symbols
# - No special shell characters that need escaping
# Example: T9r@pH5$mK2&vL8*wN4!cX7^bZ3#dF6%

# ===========================================================================
# REDIS CREDENTIALS
# ===========================================================================
# Redis password (stored in ./secrets/redis_password.txt)
# Generate with: openssl rand -base64 32 > ./secrets/redis_password.txt
# Requirements:
# - Minimum 16 characters
# - Mix of uppercase, lowercase, numbers, symbols
# - No spaces or special Redis command characters
# Example: R5p@mK9$vL2&wN7*cX4!bZ8^dF3#tH6%

# ===========================================================================
# PROMETHEUS CREDENTIALS
# ===========================================================================
# Basic auth for Prometheus (stored in ./secrets/prometheus_basic_auth.txt)
# Generate with htpasswd: htpasswd -nB admin > ./secrets/prometheus_basic_auth.txt
# Or use bcrypt: python3 -c "import bcrypt; print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt()).decode())"
# Format: username:bcrypt_hash
# Example: admin:$2y$10$HASH...

# ===========================================================================
# TLS/SSL CERTIFICATES
# ===========================================================================
# Domain name for TLS certificates
DOMAIN=aura.example.com

# TLS certificate paths (stored in ./secrets/tls/)
# Generate with:
# ./deployment-security/scripts/tls-setup.sh
#
# Or manually with Let's Encrypt:
# certbot certonly --standalone -d ${DOMAIN}
# cp /etc/letsencrypt/live/${DOMAIN}/fullchain.pem ./secrets/tls/server.crt
# cp /etc/letsencrypt/live/${DOMAIN}/privkey.pem ./secrets/tls/server.key
# chmod 600 ./secrets/tls/*
#
# Or self-signed for testing (NOT FOR PRODUCTION):
# openssl req -x509 -newkey rsa:4096 -nodes \
#   -keyout ./secrets/tls/server.key \
#   -out ./secrets/tls/server.crt \
#   -days 365 -subj "/CN=${DOMAIN}"

# ===========================================================================
# DATA PATHS (for volume mounts)
# ===========================================================================
AURA_DATA_PATH=/opt/aura/data/aura
PROMETHEUS_DATA_PATH=/opt/aura/data/prometheus
GRAFANA_DATA_PATH=/opt/aura/data/grafana
POSTGRES_DATA_PATH=/opt/aura/data/postgres
REDIS_DATA_PATH=/opt/aura/data/redis

# ===========================================================================
# SECURITY BEST PRACTICES
# ===========================================================================
# 1. SECRET GENERATION
#    - Use cryptographically secure random generators
#    - Never use predictable patterns or dictionary words
#    - Minimum 32 bytes of entropy for production
#    - Different passwords for each service
#
# 2. SECRET STORAGE
#    - Store in ./secrets/ directory
#    - Add ./secrets/ to .gitignore
#    - Set file permissions to 600 (owner read/write only)
#    - Use Docker secrets (not environment variables)
#    - Consider external secret management (Vault, AWS Secrets Manager)
#
# 3. SECRET ROTATION
#    - Rotate secrets every 90 days minimum
#    - Rotate immediately after any suspected compromise
#    - Test rotation procedure in staging first
#    - Use ./deployment-security/scripts/rotate-secrets.sh
#    - Keep audit log of rotation events
#
# 4. ACCESS CONTROL
#    - Limit who can access secret files
#    - Use separate credentials for different environments
#    - Enable audit logging for secret access
#    - Monitor for unauthorized access attempts
#
# 5. BACKUP
#    - Encrypt secret backups
#    - Store backups securely off-site
#    - Test recovery procedures regularly
#    - Document recovery process
#
# ===========================================================================
# QUICK SETUP COMMANDS
# ===========================================================================
# Run these commands to set up secrets directory:

# Create secrets directory structure
# mkdir -p ./secrets/tls
# chmod 700 ./secrets
# chmod 700 ./secrets/tls

# Generate all secrets automatically
# ./deployment-security/scripts/generate-secrets.sh

# Or generate manually:
# openssl rand -base64 32 > ./secrets/grafana_admin_password.txt
# openssl rand -base64 32 > ./secrets/postgres_password.txt
# openssl rand -base64 32 > ./secrets/redis_password.txt
# htpasswd -nB admin > ./secrets/prometheus_basic_auth.txt
# ./deployment-security/scripts/tls-setup.sh

# Set proper permissions
# chmod 600 ./secrets/*.txt
# chmod 600 ./secrets/tls/*

# Verify secrets
# ls -la ./secrets/
# ls -la ./secrets/tls/

# ===========================================================================
# VALIDATION CHECKLIST
# ===========================================================================
# [ ] Secrets directory created with 700 permissions
# [ ] All secret files created with 600 permissions
# [ ] No secrets in version control (.gitignore configured)
# [ ] Each service has unique, strong password
# [ ] TLS certificates generated and valid
# [ ] Secrets backed up securely
# [ ] Access to secrets limited to authorized users only
# [ ] Rotation schedule documented
# [ ] Emergency rotation procedure tested
# [ ] Monitoring configured for secret access
# ===========================================================================
