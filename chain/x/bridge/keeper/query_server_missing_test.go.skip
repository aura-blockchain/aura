// TestQueryAllChainsValid tests AllChains with valid chains
func (suite *QueryServerMissingTestSuite) TestQueryAllChainsValid() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// Add multiple chain configs
	chains := []types.ChainConfig{
		{
			ChainId:         "paw-1",
			ChainType:       "cosmos",
			BridgeAddress:   "bridge_address_1",
			Confirmations:   12,
			Enabled:         true,
			GasLimit:        200000,
			MinBlockHeight:  0,
			LastBlockHeight: 1000,
		},
		{
			ChainId:         "xai-1",
			ChainType:       "evm",
			BridgeAddress:   "0x123456",
			Confirmations:   20,
			Enabled:         true,
			GasLimit:        300000,
			MinBlockHeight:  0,
			LastBlockHeight: 2000,
		},
	}

	for i := range chains {
		suite.Require().NoError(suite.Keeper.setChainConfig(suite.SdkCtx, &chains[i]))
	}

	req := &bridgepb.QueryAllChainsRequest{}
	resp, err := suite.queryServer.AllChains(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.Len(resp.Chains, 2)
}

