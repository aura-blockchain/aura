// TestQueryChainConfigValid tests ChainConfig with valid request
func (suite *QueryServerMissingTestSuite) TestQueryChainConfigValid() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	chainConfig := types.ChainConfig{
		ChainId:         "paw-1",
		ChainType:       "cosmos",
		BridgeAddress:   "bridge_address",
		Confirmations:   12,
		Enabled:         true,
		GasLimit:        200000,
		MinBlockHeight:  0,
		LastBlockHeight: 1000,
	}

	suite.Require().NoError(suite.Keeper.setChainConfig(suite.SdkCtx, &chainConfig))

	req := &bridgepb.QueryChainConfigRequest{
		ChainId: "paw-1",
	}
	resp, err := suite.queryServer.ChainConfig(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.Equal("paw-1", resp.Config.ChainId)
	suite.Equal("cosmos", resp.Config.ChainType)
}

