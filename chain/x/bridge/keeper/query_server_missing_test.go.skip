}

// TestQueryParamsValid tests Params with valid request
func (suite *QueryServerMissingTestSuite) TestQueryParamsValid() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// Set default params
	params := types.DefaultParams()
	suite.Require().NoError(suite.Keeper.SetParams(suite.SdkCtx, params))

	req := &bridgepb.QueryParamsRequest{}
	resp, err := suite.queryServer.Params(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.NotNil(resp.Params)
	suite.True(resp.Params.BridgingEnabled)
}
