package keeper

import (
	"testing"
	"time"

	sdkmath "cosmossdk.io/math"
	sdk "github.com/cosmos/cosmos-sdk/types"
	"github.com/stretchr/testify/suite"

	"github.com/aequitas/aura/chain/x/bridge/types"
	bridgepb "github.com/aequitas/aura/proto/aura/bridge/v1beta1"
)

type QueryServerMissingTestSuite struct {
	KeeperTestSuite
	queryServer bridgepb.QueryServer
}

func TestQueryServerMissingTestSuite(t *testing.T) {
	suite.Run(t, new(QueryServerMissingTestSuite))
}

func (suite *QueryServerMissingTestSuite) SetupTest() {
	suite.KeeperTestSuite.SetupTest()
	suite.queryServer = NewQueryServerImpl(suite.Keeper)
}

// TestQueryUserTransfersNilRequest tests UserTransfers with nil request
func (suite *QueryServerMissingTestSuite) TestQueryUserTransfersNilRequest() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	resp, err := suite.queryServer.UserTransfers(ctx, nil)
	suite.Error(err)
	suite.Nil(resp)
	suite.Contains(err.Error(), "empty request")
}

// TestQueryUserTransfersEmptyAddress tests UserTransfers with empty address
func (suite *QueryServerMissingTestSuite) TestQueryUserTransfersEmptyAddress() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	req := &bridgepb.QueryUserTransfersRequest{
		Address: "",
	}
	resp, err := suite.queryServer.UserTransfers(ctx, req)
	suite.Error(err)
	suite.Nil(resp)
	suite.Contains(err.Error(), "address cannot be empty")
}

// TestQueryUserTransfersValid tests UserTransfers with valid request
func (suite *QueryServerMissingTestSuite) TestQueryUserTransfersValid() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	userAddr := sdk.AccAddress("user______________").String()

	// Create test transfers
	transfer1 := &types.CrossChainTransfer{
		TransferId:  "transfer-1",
		SourceChain: "aura",
		TargetChain: "paw",
		Sender:      userAddr,
		Recipient:   "recipient_address",
		Amount:      sdkmath.NewInt(1000),
		Denom:       "uaura",
		Status:      types.TransferStatus_PENDING,
		Timestamp:   time.Now(),
	}

	transfer2 := &types.CrossChainTransfer{
		TransferId:  "transfer-2",
		SourceChain: "paw",
		TargetChain: "aura",
		Sender:      "other_sender",
		Recipient:   userAddr,
		Amount:      sdkmath.NewInt(2000),
		Denom:       "upaw",
		Status:      types.TransferStatus_COMPLETED,
		Timestamp:   time.Now(),
	}

	suite.Require().NoError(suite.Keeper.setTransfer(suite.SdkCtx, transfer1))
	suite.Require().NoError(suite.Keeper.setTransfer(suite.SdkCtx, transfer2))

	req := &bridgepb.QueryUserTransfersRequest{
		Address: userAddr,
	}
	resp, err := suite.queryServer.UserTransfers(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.Len(resp.Transfers, 2)
}

// TestQueryUserTransfersWithChainFilter tests UserTransfers with chain filter
func (suite *QueryServerMissingTestSuite) TestQueryUserTransfersWithChainFilter() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	userAddr := sdk.AccAddress("user______________").String()

	// Create test transfers
	transfer1 := &types.CrossChainTransfer{
		TransferId:  "transfer-1",
		SourceChain: "aura",
		TargetChain: "paw",
		Sender:      userAddr,
		Recipient:   "recipient_address",
		Amount:      sdkmath.NewInt(1000),
		Denom:       "uaura",
		Status:      types.TransferStatus_PENDING,
		Timestamp:   time.Now(),
	}

	transfer2 := &types.CrossChainTransfer{
		TransferId:  "transfer-2",
		SourceChain: "aura",
		TargetChain: "xai",
		Sender:      userAddr,
		Recipient:   "recipient_address",
		Amount:      sdkmath.NewInt(2000),
		Denom:       "uaura",
		Status:      types.TransferStatus_COMPLETED,
		Timestamp:   time.Now(),
	}

	suite.Require().NoError(suite.Keeper.setTransfer(suite.SdkCtx, transfer1))
	suite.Require().NoError(suite.Keeper.setTransfer(suite.SdkCtx, transfer2))

	req := &bridgepb.QueryUserTransfersRequest{
		Address: userAddr,
		Chain:   "paw",
	}
	resp, err := suite.queryServer.UserTransfers(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.Len(resp.Transfers, 1)
	suite.Equal("transfer-1", resp.Transfers[0].TransferId)
}

