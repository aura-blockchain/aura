// TestQueryParamsNilRequest tests Params with nil request
func (suite *QueryServerMissingTestSuite) TestQueryParamsNilRequest() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	resp, err := suite.queryServer.Params(ctx, nil)
	suite.Error(err)
