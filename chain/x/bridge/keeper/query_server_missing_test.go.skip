// TestQuerySharedIdentityValid tests SharedIdentity with valid request
func (suite *QueryServerMissingTestSuite) TestQuerySharedIdentityValid() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	auraAddr := sdk.AccAddress("aura______________").String()
	identity := types.SharedIdentity{
		AuraAddress: auraAddr,
		LinkedAddresses: []*types.LinkedAddress{
			{
				Chain:   "paw",
				Address: "paw_address",
			},
		},
		CreatedAt: time.Now(),
	}

	suite.Require().NoError(suite.Keeper.setSharedIdentity(suite.SdkCtx, &identity))

	req := &bridgepb.QuerySharedIdentityRequest{
		Address: auraAddr,
	}
	resp, err := suite.queryServer.SharedIdentity(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.Equal(auraAddr, resp.Identity.AuraAddress)
	suite.Len(resp.Identity.LinkedAddresses, 1)
}

