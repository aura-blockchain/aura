	resp, err := suite.queryServer.BridgeStats(ctx, nil)
	suite.Error(err)
	suite.Nil(resp)
	suite.Contains(err.Error(), "empty request")
}

// TestQueryBridgeStatsValid tests BridgeStats with valid request
func (suite *QueryServerMissingTestSuite) TestQueryBridgeStatsValid() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// Create some transfers for stats
	transfers := []types.CrossChainTransfer{
		{
			TransferId:  "transfer-1",
			SourceChain: "aura",
			TargetChain: "paw",
			Sender:      sdk.AccAddress("sender1___________").String(),
			Recipient:   "recipient1",
			Amount:      sdkmath.NewInt(1000),
			Denom:       "uaura",
			Status:      types.TransferStatus_COMPLETED,
			Timestamp:   time.Now(),
		},
		{
			TransferId:  "transfer-2",
			SourceChain: "aura",
			TargetChain: "xai",
			Sender:      sdk.AccAddress("sender2___________").String(),
			Recipient:   "recipient2",
			Amount:      sdkmath.NewInt(2000),
			Denom:       "uaura",
			Status:      types.TransferStatus_PENDING,
			Timestamp:   time.Now(),
		},
		{
			TransferId:  "transfer-3",
			SourceChain: "paw",
			TargetChain: "aura",
			Sender:      "sender3",
			Recipient:   sdk.AccAddress("recipient3________").String(),
			Amount:      sdkmath.NewInt(3000),
			Denom:       "upaw",
			Status:      types.TransferStatus_FAILED,
			Timestamp:   time.Now(),
		},
	}

	for i := range transfers {
		suite.Require().NoError(suite.Keeper.setTransfer(suite.SdkCtx, &transfers[i]))
	}

	req := &bridgepb.QueryBridgeStatsRequest{}
	resp, err := suite.queryServer.BridgeStats(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.NotNil(resp.Stats)
	suite.Equal(uint64(3), resp.Stats.TotalTransfers)
}

