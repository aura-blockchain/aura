// TestQueryAllWrappedTokensValid tests AllWrappedTokens with valid tokens
func (suite *QueryServerMissingTestSuite) TestQueryAllWrappedTokensValid() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// Add wrapped tokens
	tokens := []types.WrappedToken{
		{
			Denom:             "weth",
			OriginalChain:     "ethereum",
			OriginalAddress:   "0x123",
			TotalSupply:       sdkmath.NewInt(1000000),
			Active:            true,
			MaxSupply:         sdkmath.NewInt(10000000),
			BurnCapPercentage: sdkmath.LegacyMustNewDecFromStr("0.1"),
		},
		{
			Denom:             "wbtc",
			OriginalChain:     "bitcoin",
			OriginalAddress:   "bc1q123",
			TotalSupply:       sdkmath.NewInt(500000),
			Active:            true,
			MaxSupply:         sdkmath.NewInt(5000000),
			BurnCapPercentage: sdkmath.LegacyMustNewDecFromStr("0.05"),
		},
	}

	for i := range tokens {
		suite.Require().NoError(suite.Keeper.setWrappedToken(suite.SdkCtx, &tokens[i]))
	}

	req := &bridgepb.QueryAllWrappedTokensRequest{}
	resp, err := suite.queryServer.AllWrappedTokens(ctx, req)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.Len(resp.Tokens, 2)
}

