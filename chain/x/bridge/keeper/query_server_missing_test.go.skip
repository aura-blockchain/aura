// TestQuerySharedIdentityNonExistent tests SharedIdentity with non-existent identity
func (suite *QueryServerMissingTestSuite) TestQuerySharedIdentityNonExistent() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	req := &bridgepb.QuerySharedIdentityRequest{
		Address: sdk.AccAddress("nonexistent_______").String(),
