package keeper

import (
	"testing"
	"time"

	sdkmath "cosmossdk.io/math"
	sdk "github.com/cosmos/cosmos-sdk/types"
	"github.com/stretchr/testify/suite"

	"github.com/aequitas/aura/chain/x/bridge/types"
)

type KeeperMissingFunctionsTestSuite struct {
	KeeperTestSuite
}

func TestKeeperMissingFunctionsTestSuite(t *testing.T) {
	suite.Run(t, new(KeeperMissingFunctionsTestSuite))
}

// TestDeleteTransfer tests the deleteTransfer function
func (suite *KeeperMissingFunctionsTestSuite) TestDeleteTransfer() {
	// Create and save a transfer
	transfer := &types.CrossChainTransfer{
		TransferId:  "test-delete-transfer",
		SourceChain: "aura",
		TargetChain: "paw",
		Sender:      sdk.AccAddress("sender____________").String(),
		Recipient:   "recipient_address",
		Amount:      sdkmath.NewInt(1000),
		Denom:       "uaura",
		Status:      types.TransferStatus_PENDING,
		Timestamp:   time.Now(),
	}

	suite.Require().NoError(suite.Keeper.setTransfer(suite.SdkCtx, transfer))

	// Verify it exists
	_, found := suite.Keeper.getTransfer(suite.SdkCtx, "test-delete-transfer")
	suite.True(found)

	// Delete it
	suite.Keeper.deleteTransfer(suite.SdkCtx, "test-delete-transfer")

	// Verify it's gone
	_, found = suite.Keeper.getTransfer(suite.SdkCtx, "test-delete-transfer")
	suite.False(found)
}

// TestGetSwap tests the getSwap function
func (suite *KeeperMissingFunctionsTestSuite) TestGetSwap() {
	// Create and save a swap
	swap := &types.CrossChainSwap{
		SwapId:      "test-swap-1",
		Initiator:   sdk.AccAddress("initiator_________").String(),
		SourceChain: "aura",
		TargetChain: "paw",
		SourceAsset: "uaura",
		TargetAsset: "upaw",
		Amount:      sdkmath.NewInt(1000),
		Status:      types.SwapStatus_PENDING,
		CreatedAt:   time.Now(),
		ExpiresAt:   time.Now().Add(1 * time.Hour),
	}

	suite.Require().NoError(suite.Keeper.setSwap(suite.SdkCtx, swap))

	// Get the swap
	retrieved, found := suite.Keeper.getSwap(suite.SdkCtx, "test-swap-1")
	suite.True(found)
	suite.NotNil(retrieved)
	suite.Equal("test-swap-1", retrieved.SwapId)
	suite.Equal(swap.Initiator, retrieved.Initiator)

	// Try to get non-existent swap
	_, found = suite.Keeper.getSwap(suite.SdkCtx, "non-existent-swap")
	suite.False(found)
}

// TestGetRelayerStats tests the getRelayerStats function
func (suite *KeeperMissingFunctionsTestSuite) TestGetRelayerStats() {
	relayerAddr := sdk.AccAddress("relayer___________").String()

	// Create and save relayer stats
	stats := &types.RelayerStats{
		RelayerAddress:     relayerAddr,
		TotalTransfers:     100,
		SuccessfulTransfers: 95,
		FailedTransfers:    5,
		FraudulentTransfers: 0,
	}

	suite.Require().NoError(suite.Keeper.setRelayerStats(suite.SdkCtx, stats))

	// Get the stats
	retrieved, found := suite.Keeper.getRelayerStats(suite.SdkCtx, relayerAddr)
	suite.True(found)
	suite.NotNil(retrieved)
	suite.Equal(relayerAddr, retrieved.RelayerAddress)
	suite.Equal(uint64(100), retrieved.TotalTransfers)
	suite.Equal(uint64(95), retrieved.SuccessfulTransfers)

	// Try to get non-existent relayer stats
	_, found = suite.Keeper.getRelayerStats(suite.SdkCtx, sdk.AccAddress("nonexistent_______").String())
	suite.False(found)
}

// TestRecordRelayerStats tests the recordRelayerStats function
func (suite *KeeperMissingFunctionsTestSuite) TestRecordRelayerStats() {
	relayerAddr := sdk.AccAddress("relayer___________").String()

	// Record stats for new relayer
	suite.Keeper.recordRelayerStats(suite.SdkCtx, relayerAddr, true, false)

	// Verify stats were created
	stats, found := suite.Keeper.getRelayerStats(suite.SdkCtx, relayerAddr)
	suite.True(found)
	suite.Equal(uint64(1), stats.TotalTransfers)
	suite.Equal(uint64(1), stats.SuccessfulTransfers)
	suite.Equal(uint64(0), stats.FailedTransfers)
	suite.Equal(uint64(0), stats.FraudulentTransfers)

	// Record a failed transfer
	suite.Keeper.recordRelayerStats(suite.SdkCtx, relayerAddr, false, false)
	stats, found = suite.Keeper.getRelayerStats(suite.SdkCtx, relayerAddr)
	suite.True(found)
	suite.Equal(uint64(2), stats.TotalTransfers)
	suite.Equal(uint64(1), stats.SuccessfulTransfers)
	suite.Equal(uint64(1), stats.FailedTransfers)

	// Record a fraudulent transfer
	suite.Keeper.recordRelayerStats(suite.SdkCtx, relayerAddr, false, true)
	stats, found = suite.Keeper.getRelayerStats(suite.SdkCtx, relayerAddr)
	suite.True(found)
	suite.Equal(uint64(3), stats.TotalTransfers)
	suite.Equal(uint64(1), stats.FraudulentTransfers)
}

// TestSetProcessedSourceHash tests the SetProcessedSourceHash function
func (suite *KeeperMissingFunctionsTestSuite) TestSetProcessedSourceHash() {
	sourceChain := "ethereum"
	sourceHash := "0x1234567890abcdef"

	// Set processed source hash
	suite.Keeper.SetProcessedSourceHash(suite.SdkCtx, sourceChain, sourceHash)

	// Verify it was set
	isProcessed := suite.Keeper.IsSourceHashProcessed(suite.SdkCtx, sourceChain, sourceHash)
	suite.True(isProcessed)

	// Verify non-existent hash returns false
	isProcessed = suite.Keeper.IsSourceHashProcessed(suite.SdkCtx, sourceChain, "0xnonexistent")
	suite.False(isProcessed)
}

