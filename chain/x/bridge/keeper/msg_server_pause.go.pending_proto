package keeper

import (
	"context"
	"fmt"

	sdk "github.com/cosmos/cosmos-sdk/types"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/status"

	"github.com/aequitas/aura/chain/x/bridge/types"
	bridgepb "github.com/aequitas/aura/proto/aura/bridge/v1beta1"
)

// EmergencyPause pauses bridge operations in response to detected anomaly or attack.
//
// SECURITY CRITICAL: This function implements emergency stop functionality:
//   1. Authorization: Only addresses in EmergencyPauseAddresses can trigger
//   2. Global or per-chain pause: Can pause all chains or specific chains
//   3. Audit trail: Emits event with reason and triggering address
//   4. Immediate effect: Takes effect in the same block
//
// Attack vectors prevented:
//   - Ongoing exploit: Stops further damage while investigation proceeds
//   - Anomaly detection: Allows guardians to pause when suspicious activity detected
//   - Bridge compromise: Provides emergency stop before full governance vote
//
// Parameters:
//   - msg: Contains guardian signature and pause reason
//
// Returns:
//   - Response with success status
//   - Error if: signer not authorized, already paused
func (ms msgServer) EmergencyPause(goCtx context.Context, msg *bridgepb.MsgEmergencyPause) (*bridgepb.MsgEmergencyPauseResponse, error) {
	if msg == nil {
		return nil, status.Error(codes.InvalidArgument, "request cannot be nil")
	}

	ctx := sdk.UnwrapSDKContext(goCtx)

	// CRITICAL SECURITY: Verify signer is authorized for emergency pause
	if msg.Signer == "" {
		return nil, status.Error(codes.Unauthenticated, "signer required")
	}

	if !ms.Keeper.IsEmergencyPauseAuthorized(ctx, msg.Signer) {
		return nil, status.Error(codes.PermissionDenied,
			fmt.Sprintf("address %s not authorized for emergency pause", msg.Signer))
	}

	// Get current params
	params := ms.Keeper.GetParams(ctx)

	// Check if already paused
	if len(msg.Chains) == 0 {
		// Global pause requested
		if params.Paused {
			return nil, status.Error(codes.FailedPrecondition,
				"bridge already globally paused")
		}
		params.Paused = true
	} else {
		// Per-chain pause requested
		for _, chain := range msg.Chains {
			// Check if chain already paused
			alreadyPaused := false
			for _, pausedChain := range params.PausedChains {
				if pausedChain == chain {
					alreadyPaused = true
					break
				}
			}
			if !alreadyPaused {
				params.PausedChains = append(params.PausedChains, chain)
			}
		}
	}

	// Update params
	if err := ms.Keeper.SetParams(ctx, params); err != nil {
		return nil, status.Error(codes.Internal, err.Error())
	}

	// Emit critical event for monitoring and audit
	ctx.EventManager().EmitEvent(
		sdk.NewEvent(
			"bridge_emergency_paused",
			sdk.NewAttribute("signer", msg.Signer),
			sdk.NewAttribute("reason", msg.Reason),
			sdk.NewAttribute("global_pause", fmt.Sprintf("%t", params.Paused)),
			sdk.NewAttribute("paused_chains", fmt.Sprintf("%v", params.PausedChains)),
			sdk.NewAttribute("block_height", fmt.Sprintf("%d", ctx.BlockHeight())),
		),
	)

	return &bridgepb.MsgEmergencyPauseResponse{Success: true}, nil
}

// Unpause resumes bridge operations after governance approval.
//
// SECURITY CRITICAL: This function resumes operations after emergency pause:
//   1. Authorization: Only governance authority can unpause
//   2. Global or per-chain unpause: Can resume all chains or specific chains
//   3. Audit trail: Emits event with unpause details
//   4. Careful resumption: Requires explicit action, never auto-resumes
//
// Security considerations:
//   - Only governance can unpause (not emergency guardians)
//   - Requires explicit chains list or global flag
//   - Does not automatically resume after time period (manual only)
//
// Parameters:
//   - msg: Contains governance authority signature
//
// Returns:
//   - Response with success status
//   - Error if: authority not valid, not paused
func (ms msgServer) Unpause(goCtx context.Context, msg *bridgepb.MsgUnpause) (*bridgepb.MsgUnpauseResponse, error) {
	if msg == nil {
		return nil, status.Error(codes.InvalidArgument, "request cannot be nil")
	}

	ctx := sdk.UnwrapSDKContext(goCtx)

	// CRITICAL SECURITY: Verify authority is governance
	// TODO: Implement proper governance authority check
	// For now, require non-empty authority (will be enforced by msg signer validation)
	if msg.Authority == "" {
		return nil, status.Error(codes.Unauthenticated, "authority required")
	}

	// Get current params
	params := ms.Keeper.GetParams(ctx)

	// Unpause logic
	if len(msg.Chains) == 0 {
		// Global unpause requested
		if !params.Paused {
			return nil, status.Error(codes.FailedPrecondition,
				"bridge not globally paused")
		}
		params.Paused = false
		// Also clear all per-chain pauses when globally unpausing
		params.PausedChains = []string{}
	} else {
		// Per-chain unpause requested
		newPausedChains := []string{}
		for _, pausedChain := range params.PausedChains {
			shouldRemove := false
			for _, chainToUnpause := range msg.Chains {
				if pausedChain == chainToUnpause {
					shouldRemove = true
					break
				}
			}
			if !shouldRemove {
				newPausedChains = append(newPausedChains, pausedChain)
			}
		}
		params.PausedChains = newPausedChains
	}

	// Update params
	if err := ms.Keeper.SetParams(ctx, params); err != nil {
		return nil, status.Error(codes.Internal, err.Error())
	}

	// Emit event for monitoring and audit
	ctx.EventManager().EmitEvent(
		sdk.NewEvent(
			"bridge_unpaused",
			sdk.NewAttribute("authority", msg.Authority),
			sdk.NewAttribute("global_pause", fmt.Sprintf("%t", params.Paused)),
			sdk.NewAttribute("remaining_paused_chains", fmt.Sprintf("%v", params.PausedChains)),
			sdk.NewAttribute("block_height", fmt.Sprintf("%d", ctx.BlockHeight())),
		),
	)

	return &bridgepb.MsgUnpauseResponse{Success: true}, nil
}
