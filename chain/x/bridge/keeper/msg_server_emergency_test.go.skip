func (suite *MsgServerEmergencyTestSuite) TestUnpauseEmptyAuthority() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	msg := &bridgepb.MsgUnpause{
		Authority: "",
		Chains:    []string{},
