package keeper

import (
	"testing"

	sdk "github.com/cosmos/cosmos-sdk/types"
	"github.com/stretchr/testify/suite"

	bridgepb "github.com/aequitas/aura/proto/aura/bridge/v1beta1"
)

type MsgServerEmergencyTestSuite struct {
	KeeperTestSuite
	msgServer bridgepb.MsgServer
}

func TestMsgServerEmergencyTestSuite(t *testing.T) {
	suite.Run(t, new(MsgServerEmergencyTestSuite))
}

func (suite *MsgServerEmergencyTestSuite) SetupTest() {
	suite.KeeperTestSuite.SetupTest()
	suite.msgServer = NewMsgServerImpl(suite.Keeper)
}

// TestEmergencyPauseNilRequest tests EmergencyPause with nil request
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseNilRequest() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	resp, err := suite.msgServer.EmergencyPause(ctx, nil)
	suite.Error(err)
	suite.Nil(resp)
	suite.Contains(err.Error(), "request cannot be nil")
}

// TestEmergencyPauseEmptySigner tests EmergencyPause with empty signer
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseEmptySigner() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	msg := &bridgepb.MsgEmergencyPause{
		Signer: "",
		Reason: "test pause",
		Chains: []string{},
	}

	resp, err := suite.msgServer.EmergencyPause(ctx, msg)
	suite.Error(err)
	suite.Nil(resp)
	suite.Contains(err.Error(), "signer required")
}

// TestEmergencyPauseEmptyReason tests EmergencyPause with empty reason
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseEmptyReason() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	signer := sdk.AccAddress("signer____________").String()
	msg := &bridgepb.MsgEmergencyPause{
		Signer: signer,
		Reason: "",
		Chains: []string{},
	}

	resp, err := suite.msgServer.EmergencyPause(ctx, msg)
	suite.Error(err)
	suite.Nil(resp)
	suite.Contains(err.Error(), "reason required")
}

// TestEmergencyPauseUnauthorized tests EmergencyPause with unauthorized signer
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseUnauthorized() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

