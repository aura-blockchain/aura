	resp, err := suite.msgServer.Unpause(ctx, msg)
	suite.Error(err)
	suite.Nil(resp)
	suite.Contains(err.Error(), "authority required")
}

// TestUnpauseGlobal tests global unpause
func (suite *MsgServerEmergencyTestSuite) TestUnpauseGlobal() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// First, set the bridge to paused state
	params := suite.Keeper.GetParams(suite.SdkCtx)
	params.Paused = true
	params.PausedChains = []string{"paw", "xai"}
	suite.Require().NoError(suite.Keeper.SetParams(suite.SdkCtx, params))

	// Now unpause globally (would normally require governance authority)
	authority := sdk.AccAddress("governance________").String()
	msg := &bridgepb.MsgUnpause{
		Authority: authority,
		Chains:    []string{}, // Empty means global unpause
	}

	resp, err := suite.msgServer.Unpause(ctx, msg)

	// In the test environment, this should succeed since we're not enforcing
	// governance authority checks (those are done at the SDK level)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.True(resp.Success)

	// Verify params were updated
	updatedParams := suite.Keeper.GetParams(suite.SdkCtx)
	suite.False(updatedParams.Paused)
	suite.Empty(updatedParams.PausedChains) // Global unpause clears chain-specific pauses
}

// TestUnpauseSpecificChains tests unpausing specific chains
func (suite *MsgServerEmergencyTestSuite) TestUnpauseSpecificChains() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// First, set specific chains to paused state
	params := suite.Keeper.GetParams(suite.SdkCtx)
	params.Paused = false
	params.PausedChains = []string{"paw", "xai", "ethereum"}
	suite.Require().NoError(suite.Keeper.SetParams(suite.SdkCtx, params))

	// Unpause only paw and xai
	authority := sdk.AccAddress("governance________").String()
	msg := &bridgepb.MsgUnpause{
		Authority: authority,
		Chains:    []string{"paw", "xai"},
	}

	resp, err := suite.msgServer.Unpause(ctx, msg)
	suite.NoError(err)
	suite.NotNil(resp)
	suite.True(resp.Success)

	// Verify only specified chains were unpaused
	updatedParams := suite.Keeper.GetParams(suite.SdkCtx)
	suite.False(updatedParams.Paused)
	suite.NotContains(updatedParams.PausedChains, "paw")
	suite.NotContains(updatedParams.PausedChains, "xai")
	suite.Contains(updatedParams.PausedChains, "ethereum") // Should still be paused
}

// TestUnpauseWhenNotPaused tests unpausing when bridge is not paused
func (suite *MsgServerEmergencyTestSuite) TestUnpauseWhenNotPaused() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// Ensure bridge is not paused
	params := suite.Keeper.GetParams(suite.SdkCtx)
	params.Paused = false
	params.PausedChains = []string{}
	suite.Require().NoError(suite.Keeper.SetParams(suite.SdkCtx, params))

	authority := sdk.AccAddress("governance________").String()
	msg := &bridgepb.MsgUnpause{
		Authority: authority,
		Chains:    []string{},
	}

	resp, err := suite.msgServer.Unpause(ctx, msg)
	suite.NoError(err) // Should succeed even if already unpaused
	suite.NotNil(resp)
	suite.True(resp.Success)

	// Verify state remains unpaused
	updatedParams := suite.Keeper.GetParams(suite.SdkCtx)
	suite.False(updatedParams.Paused)
	suite.Empty(updatedParams.PausedChains)
}

// TestEmergencyPauseChainNormalization tests that chain names are normalized
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseChainNormalization() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	authorizedSigner := sdk.AccAddress("authorized________").String()
	msg := &bridgepb.MsgEmergencyPause{
		Signer: authorizedSigner,
		Reason: "test normalization",
		Chains: []string{"PAW", "Xai", "ETHEREUM"}, // Mixed case
	}

	resp, err := suite.msgServer.EmergencyPause(ctx, msg)

	// Expect unauthorized unless authorization is set up
	if err != nil {
		suite.Contains(err.Error(), "not authorized")
	} else {
		suite.NotNil(resp)

		// Verify chains were normalized (converted to lowercase)
		updatedParams := suite.Keeper.GetParams(suite.SdkCtx)
		// The normalizeChain function should handle this
		suite.NotEmpty(updatedParams.PausedChains)
	}
}

// TestEmergencyPauseDuplicateChains tests pausing the same chain multiple times
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseDuplicateChains() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// First, pause paw chain
	params := suite.Keeper.GetParams(suite.SdkCtx)
	params.PausedChains = []string{"paw"}
	suite.Require().NoError(suite.Keeper.SetParams(suite.SdkCtx, params))

	// Try to pause paw again
	authorizedSigner := sdk.AccAddress("authorized________").String()
	msg := &bridgepb.MsgEmergencyPause{
		Signer: authorizedSigner,
		Reason: "test duplicate",
		Chains: []string{"paw"},
	}

	resp, err := suite.msgServer.EmergencyPause(ctx, msg)

	if err != nil {
		suite.Contains(err.Error(), "not authorized")
	} else {
		suite.NotNil(resp)

		// Verify paw is not duplicated in the list
		updatedParams := suite.Keeper.GetParams(suite.SdkCtx)
		pawCount := 0
		for _, chain := range updatedParams.PausedChains {
			if chain == "paw" {
				pawCount++
			}
		}
		suite.Equal(1, pawCount, "paw should appear only once in paused chains")
	}
}
