// TestEmergencyPauseGlobalAuthorized tests global emergency pause with authorized signer
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseGlobalAuthorized() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	// Get or create an authorized signer (governance address or emergency guardian)
	// In a real scenario, this would be a governance address
	// For testing, we'll use a test address that we authorize
	authorizedSigner := sdk.AccAddress("authorized________").String()

	// Get current params
	params := suite.Keeper.GetParams(suite.SdkCtx)

	// Add the signer to emergency pause addresses (if that field exists)
	// Otherwise, we'll need to mock the IsEmergencyPauseAuthorized function
	// For now, we'll test that the function is called correctly

	msg := &bridgepb.MsgEmergencyPause{
		Signer: authorizedSigner,
		Reason: "security incident detected",
		Chains: []string{}, // Empty means global pause
	}

	// This will fail with unauthorized unless we properly set up authorization
	// The actual authorization check depends on params.EmergencyPauseAddresses or governance
	resp, err := suite.msgServer.EmergencyPause(ctx, msg)

	// We expect this to fail with unauthorized in the test environment
	// since we haven't set up the authorization properly
	if err != nil {
		suite.Contains(err.Error(), "not authorized")
	} else {
		// If it succeeds (in case authorization is mocked), verify the pause
		suite.NotNil(resp)
		suite.True(resp.Success)

		// Verify params were updated
		updatedParams := suite.Keeper.GetParams(suite.SdkCtx)
		suite.True(updatedParams.Paused)
	}

	// Reset params
	params.Paused = false
	suite.Require().NoError(suite.Keeper.SetParams(suite.SdkCtx, params))
}

// TestEmergencyPauseSpecificChains tests pausing specific chains
func (suite *MsgServerEmergencyTestSuite) TestEmergencyPauseSpecificChains() {
	ctx := sdk.WrapSDKContext(suite.SdkCtx)

	authorizedSigner := sdk.AccAddress("authorized________").String()
	msg := &bridgepb.MsgEmergencyPause{
		Signer: authorizedSigner,
		Reason: "suspicious activity on paw chain",
		Chains: []string{"paw", "xai"},
	}

	resp, err := suite.msgServer.EmergencyPause(ctx, msg)

	// Expect unauthorized unless we've set up authorization
	if err != nil {
		suite.Contains(err.Error(), "not authorized")
	} else {
		suite.NotNil(resp)
		suite.True(resp.Success)

		// Verify specific chains were paused
		updatedParams := suite.Keeper.GetParams(suite.SdkCtx)
		suite.Contains(updatedParams.PausedChains, "paw")
		suite.Contains(updatedParams.PausedChains, "xai")
		suite.False(updatedParams.Paused) // Global pause should still be false
	}
}

